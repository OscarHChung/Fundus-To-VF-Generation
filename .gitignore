# ── Large binaries: model weights ──────────────────────────────────────────────
# Checkpoints bundle the frozen RETFound encoder (~500 MB - 1.2 GB each).
*.pth
*.pt

# ── Large binaries: raw data ───────────────────────────────────────────────────
data/fundus/grape_fundus_images/*.jpg
# PAPILA raw download (zip + extracted images/spreadsheets) -- see data/external/papila/SOURCE.md
# Only the harmonized data/external/papila_records.json + SOURCE.md are tracked.
data/external/papila/*
!data/external/papila/SOURCE.md
# Paper draft PDF (large, author-managed)
*.pdf

# ── Regenerable caches ─────────────────────────────────────────────────────────
# Frozen-feature caches are large and rebuildable from the encoder; the per-fold
# out-of-fold prediction caches are NOT ignored -- at ~160 KB each they are the
# source of truth for every published number and reproduce all figures torch-free.
decoder/results/auto/*.npz

__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ── OS cruft ───────────────────────────────────────────────────────────────────
.DS_Store
